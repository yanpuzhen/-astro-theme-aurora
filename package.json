{
  "name": "aurora-3",
  "version": "3.0.0-rc.1",
  "description": "Aurora 3.0, an Astro-based evolution of the Aurora theme.",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanpuzhen/-astro-theme-aurora.git"
  },
  "homepage": "https://github.com/yanpuzhen/-astro-theme-aurora",
  "bugs": {
    "url": "https://github.com/yanpuzhen/-astro-theme-aurora/issues"
  },
  "keywords": [
    "aurora",
    "astro",
    "astro-theme",
    "blog",
    "static-site",
    "vue-islands"
  ],
  "engines": {
    "node": ">=18.20.8 <19 || >=20.3.0 <21 || >=22.0.0",
    "pnpm": ">=7.1.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "check": "astro check",
    "test:browser": "playwright test",
    "pretest": "pnpm build",
    "test": "node scripts/verify-build.mjs && node --experimental-strip-types scripts/verify-rc.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/vue": "^5.0.0",
    "astro": "^5.13.0",
    "vue": "^3.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "pagefind": "^1.5.2",
    "rehype-raw": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
