---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import DiaIsland from '../islands/DiaIsland.vue'
import { config } from '../lib/config'
import { assetPath, sitePath, withoutBase } from '../lib/routing'

interface Props {
  title: string; description?: string; canonicalPath?: string; image?: string; type?: 'website' | 'article'
  author?: string; published?: Date; updated?: Date; keywords?: string[]; lang?: string; jsonLd?: Record<string, unknown>
}
const { title, description, canonicalPath, image, type = 'website', author, published, updated, keywords, lang = config.site.language, jsonLd } = Astro.props
const path = canonicalPath ? withoutBase(canonicalPath) : withoutBase(Astro.url.pathname)
const canonical = new URL(sitePath(path), Astro.site)
const imageUrl = image ? new URL(image.match(/^https?:\/\//) ? image : sitePath(image), Astro.site) : undefined
const structuredData = jsonLd || {
  '@context': 'https://schema.org', '@type': type === 'article' ? 'Article' : 'WebSite', name: title,
  url: canonical.toString(), description, ...(author ? { author: { '@type': 'Person', name: author } } : {}),
}
const diaEnabled = import.meta.env.PUBLIC_AURORA_DIA === 'true'
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <link rel="icon" href={assetPath('/favicon.svg')} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    {diaEnabled && <DiaIsland client:idle locale={lang} />}
  </body>
</html>
