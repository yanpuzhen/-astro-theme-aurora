---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { collectTags } from '../../lib/taxonomy'
import { isPublicPost } from '../../lib/content'
import { tagPath } from '../../lib/routing'
const tags = collectTags((await getCollection('posts')).filter(isPublicPost))
---

<BaseLayout title="Tags · Aurora" canonicalPath="/tags/">
  <section class="taxonomy-page">
    <p class="eyebrow">Taxonomy</p><h1 class="page-heading">Tags</h1>
    <div class="tag-cloud">{tags.map((tag) => <a href={tagPath(tag.name)}>{tag.name}<sup>{tag.posts.length}</sup></a>)}</div>
  </section>
</BaseLayout>
