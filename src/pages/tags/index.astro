---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { collectTags } from '../../lib/taxonomy'
import { isPublicPost } from '../../lib/content'
import { tagPath } from '../../lib/routing'
const tags = collectTags((await getCollection('posts')).filter(isPublicPost))
---
<BaseLayout title="Tags · Aurora" canonicalPath="/tags/">
  <h1 class="page-heading">Tags</h1>
  <div class="taxonomy-grid">{tags.map((tag) => <a class="taxonomy-card" href={tagPath(tag.name)}><strong>{tag.name}</strong><span>{tag.posts.length} articles</span></a>)}</div>
</BaseLayout>
