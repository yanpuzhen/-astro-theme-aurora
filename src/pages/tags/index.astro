---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { collectTags } from '../../lib/taxonomy'
import { isPublicPost } from '../../lib/content'
import { localizedSitePath, tagPath } from '../../lib/routing'
import { messagesFor } from '../../lib/i18n'
import { isLocale } from '../../lib/content'
const locale = 'en' as const
const messages = messagesFor(locale)
const tags = collectTags((await getCollection('posts')).filter(isPublicPost).filter((post) => isLocale(post, locale)))
const localeLinks = { en: localizedSitePath('/tags/', 'en'), 'zh-CN': localizedSitePath('/tags/', 'zh-CN') }
---

<BaseLayout title={`${messages.tags} · Aurora`} canonicalPath="/tags/" lang={locale} localeLinks={localeLinks} alternateLocaleLinks={localeLinks}>
  <section class="taxonomy-page">
    <p class="eyebrow">{messages.taxonomy}</p><h1 class="page-heading">{messages.tags}</h1>
    <div class="tag-cloud">{tags.map((tag) => <a href={tagPath(tag.name, locale)}>{tag.name}<sup>{tag.posts.length}</sup></a>)}</div>
  </section>
</BaseLayout>
