---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import TagList from '../components/TagList.astro'
import Comments from '../components/Comments.astro'
import CodeCopyIsland from '../islands/CodeCopyIsland.vue'
import { config } from '../lib/config'
import { isPublicPost } from '../lib/content'
import { excerptFor, archivePosts, previousNext } from '../lib/posts'
import { postPath, postAliases, resolvePostPath, routeManifestEntry, sitePath } from '../lib/routing'
import LightboxIsland from '../islands/LightboxIsland.vue'

export async function getStaticPaths() {
  const entries = await getCollection('posts', isPublicPost)
  const paths = new Map<string, CollectionEntry<'posts'>>()
  for (const post of entries) {
    const canonical = resolvePostPath(post)
    const candidates = canonical.startsWith('/post/') ? postAliases(post) : [canonical, ...postAliases(post)]
    for (const path of candidates) if (!path.endsWith('.html')) paths.set(path, post)
  }
  return [...paths.entries()].map(([path, post]) => ({
    params: { path: path.replace(/^\//, '').replace(/\/$/, '') }, props: { post, isAlias: path !== resolvePostPath(post) },
  }))
}

const { post, isAlias } = Astro.props as { post: CollectionEntry<'posts'>; isAlias: boolean }
const { Content, headings } = await render(post)
const allPosts = await getCollection('posts')
const { previous, next } = previousNext(archivePosts(allPosts.filter(isPublicPost)), post)
const manifest = routeManifestEntry(post)
const description = post.data.description || excerptFor(post)
const image = post.data.cover
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description,
  url: new URL(sitePath(manifest.canonicalPath), Astro.site).toString(), datePublished: post.data.date.toISOString(),
  ...(post.data.updated ? { dateModified: post.data.updated.toISOString() } : {}),
  author: { '@type': 'Person', name: post.data.author.name }, ...(image ? { image } : {}),
}
---
<BaseLayout title={`${post.data.title} · ${config.site.title}`} description={description} canonicalPath={manifest.canonicalPath}
  image={image} type="article" author={post.data.author.name} published={post.data.date} updated={post.data.updated}
  keywords={post.data.keywords} lang={post.data.lang} jsonLd={jsonLd}>
  <article class="article-shell" data-pagefind-body={!isAlias ? true : undefined}>
    <header class="article-header">
      <div class="post-card__meta">{post.data.categories[0] && <span>{post.data.categories[0]}</span>}<time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString(post.data.lang)}</time>{post.data.updated && <time datetime={post.data.updated.toISOString()}>Updated {post.data.updated.toLocaleDateString(post.data.lang)}</time>}</div>
      <h1 class="article-title">{post.data.title}</h1>
      <div class="article-meta"><span>{post.data.author.name}</span><TagList tags={post.data.tags} /></div>
      {description && <p class="article-summary">{description}</p>}
      {image && <img class="article-cover" src={image} alt={post.data.title} loading="eager" />}
    </header>
    {headings.length > 0 && post.data.toc && <nav class="taxonomy-card" aria-label="Table of contents"><strong>Contents</strong><ul>{headings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
    <div class="post-html"><Content /></div>
    <nav class="article-nav" aria-label="Article navigation">{previous ? <a href={postPath(previous)}>← {previous.data.title}</a> : <span />}{next ? <a href={postPath(next)}>{next.data.title} →</a> : <span />}</nav>
    <Comments enabled={post.data.comments && config.comments.enabled} provider={config.comments.provider} providerId={config.comments.gitalkIdMode} legacyUid={manifest.legacyUid} canonicalPath={manifest.canonicalUrlPath} commentPath={manifest.commentPath} title={post.data.title} />
    <CodeCopyIsland client:visible />
    <LightboxIsland client:visible />
  </article>
</BaseLayout>
