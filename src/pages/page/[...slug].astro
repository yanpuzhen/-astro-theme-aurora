---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { customPagePath } from '../../lib/routing'

export async function getStaticPaths() {
  const pages = await getCollection('pages')
  return pages.filter((page) => page.id !== 'about').map((page) => ({
    params: { slug: page.id }, props: { page },
  }))
}

const { page } = Astro.props as { page: CollectionEntry<'pages'> }
const { Content } = await render(page)
---
<BaseLayout title={page.data.title} description={page.data.description} canonicalPath={customPagePath(page.id)}>
  <article class="article-shell">
    <header class="article-header"><h1 class="article-title">{page.data.title}</h1></header>
    <div class="post-html"><Content /></div>
  </article>
</BaseLayout>
