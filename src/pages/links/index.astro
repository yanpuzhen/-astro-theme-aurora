---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FriendLinks from '../../components/FriendLinks.astro'
import { messagesFor } from '../../lib/i18n'
import { localizedSitePath } from '../../lib/routing'

const messages = messagesFor('en')
const localeLinks = { en: localizedSitePath('/links/', 'en'), 'zh-CN': localizedSitePath('/links/', 'zh-CN') }
---
<BaseLayout title={`${messages.links} · Aurora`} description={messages.linksDescription} canonicalPath="/links/" lang="en" localeLinks={localeLinks} alternateLocaleLinks={localeLinks}>
  <FriendLinks locale="en" />
</BaseLayout>
