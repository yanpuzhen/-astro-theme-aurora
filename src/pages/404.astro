---
import BaseLayout from '../layouts/BaseLayout.astro'
import { localizedSitePath } from '../lib/routing'
import { messagesFor } from '../lib/i18n'
const messages = messagesFor('en')
const localeLinks = { en: localizedSitePath('/404/', 'en'), 'zh-CN': localizedSitePath('/404/', 'zh-CN') }
---
<BaseLayout title="404 · Aurora" canonicalPath="/404/" lang="en" localeLinks={localeLinks}>
  <article class="not-found-page article-shell"><div class="post-html"><p class="eyebrow">Aurora / 404</p><h1 class="page-heading">404</h1><p>{messages.notFoundMessage}</p><div class="not-found-actions"><a class="button-link" href={localizedSitePath('/', 'en')}>{messages.homeAction}</a><a class="button-link button-link--quiet" href={localizedSitePath('/search/', 'en')}>{messages.searchAction}</a></div></div></article>
</BaseLayout>
