---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Pagination from '../../components/Pagination.astro'
import { archivePosts, paginate } from '../../lib/posts'
import { isPublicPost } from '../../lib/content'
import { postPath } from '../../lib/routing'

const posts = archivePosts((await getCollection('posts')).filter(isPublicPost))
const archivePageSize = 12
const current = paginate(posts, 1, archivePageSize)
const years = new Map<number, typeof posts>()
for (const post of current.items) { const year = post.data.date.getFullYear(); years.set(year, [...(years.get(year) || []), post]) }
---

<BaseLayout title="Archives · Aurora" canonicalPath="/archives/">
  <section class="taxonomy-page">
    <p class="eyebrow">Timeline</p>
    <h1 class="page-heading">Archives</h1>
    <div class="archive-timeline">
      {[...years.entries()].map(([year, yearPosts]) => <section class="timeline-year">
        <div class="timeline-marker" aria-hidden="true"></div>
        <h2>{year}</h2>
        <ol>
          {yearPosts.map((post) => <li><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString(post.data.lang, { month: 'short', day: 'numeric' })}</time><a href={postPath(post)}>{post.data.title}</a><span>{post.data.categories[0] || 'Aurora'}</span></li>)}
        </ol>
      </section>)}
    </div>
    <Pagination page={1} pageCount={Math.max(1, Math.ceil(posts.length / archivePageSize))} kind="archive" />
  </section>
</BaseLayout>
