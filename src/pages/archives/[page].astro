---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Pagination from '../../components/Pagination.astro'
import { archivePosts, paginate } from '../../lib/posts'
import { isPublicPost } from '../../lib/content'
import { archivePath, postPath } from '../../lib/routing'
export async function getStaticPaths() {
  const archivePageSize = 12
  const posts = archivePosts((await getCollection('posts')).filter(isPublicPost))
  const pageCount = Math.ceil(posts.length / archivePageSize)
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => ({ params: { page: String(index + 2) }, props: { page: index + 2, pageCount } }))
}
const posts = archivePosts((await getCollection('posts')).filter(isPublicPost))
const archivePageSize = 12
const { page } = Astro.props
const pageCount = Astro.props.pageCount as number
const current = paginate(posts, page, archivePageSize)
---

<BaseLayout title={`Archive ${page} · Aurora`} canonicalPath={archivePath(page)}>
  <section class="taxonomy-page">
    <p class="eyebrow">Timeline</p>
    <h1 class="page-heading">Archives <span>· {page}</span></h1>
    <div class="archive-timeline">
      {current.items.map((post) => <article class="timeline-year timeline-year--single"><div class="timeline-marker" aria-hidden="true"></div><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString(post.data.lang)}</time><h2><a href={postPath(post)}>{post.data.title}</a></h2><p>{post.data.description}</p></article>)}
    </div>
    <Pagination page={page} pageCount={pageCount} kind="archive" />
  </section>
</BaseLayout>
