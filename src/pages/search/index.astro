---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SearchIsland from '../../islands/SearchIsland.vue'
import { config } from '../../lib/config'
import { messagesFor } from '../../lib/i18n'
import { localizedSitePath } from '../../lib/routing'
const messages = messagesFor(config.site.language)
const localeLinks = { en: localizedSitePath('/search/', 'en'), 'zh-CN': localizedSitePath('/search/', 'zh-CN') }
---
<BaseLayout title={`${messages.search} · Aurora`} canonicalPath="/search/" lang={config.site.language} localeLinks={localeLinks} alternateLocaleLinks={localeLinks}><section class="search-page"><h1 class="page-heading">{messages.search}</h1><SearchIsland client:idle base={import.meta.env.BASE_URL} locale={config.site.language} messages={messages} /></section></BaseLayout>
