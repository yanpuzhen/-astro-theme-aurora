---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { localizedSitePath } from '../../lib/routing'
import { messagesFor, type AuroraLocale } from '../../lib/i18n'

export function getStaticPaths() { return [{ params: { locale: 'cn' }, props: { locale: 'zh-CN' as AuroraLocale } }] }
const { locale } = Astro.props as { locale: AuroraLocale }
const messages = messagesFor(locale)
const current = localizedSitePath('/404/', locale)
const localeLinks = { en: localizedSitePath('/404/', 'en'), 'zh-CN': localizedSitePath('/404/', 'zh-CN') }
---
<BaseLayout title="404 · Aurora" canonicalPath={current} lang={locale} localeLinks={localeLinks}>
  <article class="not-found-page article-shell"><div class="post-html"><p class="eyebrow">Aurora / 404</p><h1 class="page-heading">404</h1><p>{messages.notFoundMessage}</p><div class="not-found-actions"><a class="button-link" href={localizedSitePath('/', locale)}>{messages.homeAction}</a><a class="button-link button-link--quiet" href={localizedSitePath('/search/', locale)}>{messages.searchAction}</a></div></div></article>
</BaseLayout>
