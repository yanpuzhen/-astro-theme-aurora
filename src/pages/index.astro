---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { postPath } from '../lib/routing'
const posts = (await getCollection('posts', ({ data }) => !data.hidden)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
---
<BaseLayout title="Aurora 3.0">
  <h1>Aurora 3.0</h1>
  <ul>
    {posts.map((post) => <li><a href={postPath(post)}>{post.data.title}</a></li>)}
  </ul>
</BaseLayout>
