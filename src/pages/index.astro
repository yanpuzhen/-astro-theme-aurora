---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import Pagination from '../components/Pagination.astro'
import Feature from '../components/Feature.astro'
import CategoryTabs from '../components/CategoryTabs.astro'
import Sidebar from '../components/Sidebar.astro'
import { config } from '../lib/config'
import { publicPosts, selectHomePosts, paginate } from '../lib/posts'
import { collectCategories } from '../lib/taxonomy'
import { sitePath } from '../lib/routing'

const allPosts = await getCollection('posts')
const selection = selectHomePosts(allPosts, config.theme.feature)
const pageSize = selection.mode === 'feature' ? 12 : 13
const page = paginate(selection.posts, 1, pageSize)
const featureIds = new Set(selection.features.map((post) => post.id))
const listing = page.items.filter((post) => !featureIds.has(post.id))
const categories = collectCategories(publicPosts(allPosts)).map((item) => ({ name: item.name, count: item.posts.length }))
---

<BaseLayout title={config.site.title} description={config.site.description} canonicalPath="/">
  {selection.features.length > 0 && <Feature posts={selection.features} />}
  <div class="main-grid" id="article-list">
    <section class="article-list" aria-labelledby="articles-title">
      <div class="section-heading"><h2 id="articles-title" class="section-title">Latest articles</h2><a class="section-link" href={sitePath('/archives/')}>View archive <span aria-hidden="true">→</span></a></div>
      {categories.length > 0 && <CategoryTabs categories={categories} />}
      <div class="post-grid">{listing.map((post) => <PostCard post={post} />)}</div>
      <Pagination page={page.page} pageCount={page.pageCount} />
    </section>
    <Sidebar posts={publicPosts(allPosts)} />
  </div>
</BaseLayout>
