---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AboutShowcase from '../../components/AboutShowcase.astro'
import { messagesFor } from '../../lib/i18n'
import { localizedSitePath } from '../../lib/routing'
const localeLinks = { en: localizedSitePath('/about/', 'en'), 'zh-CN': localizedSitePath('/about/', 'zh-CN') }
---
<BaseLayout title="About Aurora 3" description={messagesFor('en').aboutIntro} canonicalPath="/about/" lang="en" localeLinks={localeLinks} alternateLocaleLinks={localeLinks}><AboutShowcase locale="en" /></BaseLayout>
