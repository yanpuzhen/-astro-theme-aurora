---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { collectCategories } from '../../lib/taxonomy'
import { isPublicPost } from '../../lib/content'
import { categoryPath, localizedSitePath } from '../../lib/routing'
import { isLocale } from '../../lib/content'
import { messagesFor } from '../../lib/i18n'
export async function getStaticPaths() {
  const entries = (await getCollection('posts')).filter(isPublicPost).filter((post) => isLocale(post, 'en'))
  return collectCategories(entries).map((category) => ({ params: { slug: category.slug }, props: { category } }))
}
const { category } = Astro.props
const locale = 'en' as const
const messages = messagesFor(locale)
const chineseCategories = collectCategories((await getCollection('posts')).filter(isPublicPost).filter((post) => isLocale(post, 'zh-CN')))
const chineseCounterpart = chineseCategories.some((item) => item.slug === category.slug)
const localeLinks = { en: categoryPath(category.name, locale), 'zh-CN': chineseCounterpart ? categoryPath(category.name, 'zh-CN') : localizedSitePath('/categories/', 'zh-CN') }
---
<BaseLayout title={`${category.name} · ${messages.categories}`} canonicalPath={categoryPath(category.name, locale)} lang={locale} localeLinks={localeLinks} alternateLocaleLinks={chineseCounterpart ? localeLinks : {}}>
  <section class="taxonomy-page"><p class="eyebrow">{messages.category}</p><h1 class="page-heading">{category.name}</h1>
    <div class="post-grid">{category.posts.map((post) => <PostCard post={post} locale={locale} />)}</div>
  </section>
</BaseLayout>
