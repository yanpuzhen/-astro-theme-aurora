---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { collectCategories } from '../../lib/taxonomy'
import { isPublicPost } from '../../lib/content'
import { categoryPath } from '../../lib/routing'
const categories = collectCategories((await getCollection('posts')).filter(isPublicPost))
---

<BaseLayout title="Categories · Aurora" canonicalPath="/categories/">
  <section class="taxonomy-page">
    <p class="eyebrow">Taxonomy</p><h1 class="page-heading">Categories</h1>
    <div class="category-cloud">{categories.map((category) => <a href={categoryPath(category.name)}><strong>{category.name}</strong><span>{category.posts.length} articles</span></a>)}</div>
  </section>
</BaseLayout>
