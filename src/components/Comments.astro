---
import CommentIsland from '../islands/CommentIsland.vue'
import type { CommentProvider } from '../lib/comments'
import { messagesFor } from '../lib/i18n'
import { config } from '../lib/config'
interface Props { enabled: boolean; provider: CommentProvider; providerId?: 'uid' | 'pathname'; legacyUid: string; canonicalPath: string; commentPath: string; title: string; locale?: 'en' | 'zh-CN' }
const { enabled, provider, providerId = 'uid', legacyUid, canonicalPath, commentPath, title, locale = config.site.language } = Astro.props
const messages = messagesFor(locale)
---
{enabled && provider !== 'none' && (
  <section class="comments" id="comments" data-dia="jump-to-comment" data-provider={provider} data-legacy-uid={legacyUid} data-canonical-path={canonicalPath} data-legacy-path={commentPath}>
    <h2>{messages.comments}</h2>
    <CommentIsland client:visible provider={provider} providerId={providerId} legacyUid={legacyUid} canonicalPath={canonicalPath} legacyPath={commentPath} title={title} />
  </section>
)}
