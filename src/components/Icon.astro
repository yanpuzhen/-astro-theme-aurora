---
interface Props { name: 'search' | 'language' | 'menu' | 'close' | 'arrow-left' | 'arrow-right' | 'moon' | 'sun' | 'quote' | 'tag' | 'chevron' | 'clock' | 'article' | 'github' | 'link' }
const { name } = Astro.props
---

<svg class={`icon icon-${name}`} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'search' && <><circle cx="10.8" cy="10.8" r="6.8" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="m16 16 5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" /></>}
  {name === 'language' && <><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M3.4 12h17.2M12 3c2.4 2.4 3.6 5.4 3.6 9S14.4 18.6 12 21M12 3C9.6 5.4 8.4 8.4 8.4 12s1.2 6.6 3.6 9" fill="none" stroke="currentColor" stroke-width="1.4" /></>}
  {name === 'menu' && <><path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" /></>}
  {name === 'close' && <><path d="m5 5 14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" /></>}
  {name === 'arrow-left' && <><path d="M19 12H5m7 7-7-7 7-7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></>}
  {name === 'arrow-right' && <><path d="M5 12h14m-7-7 7 7-7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></>}
  {name === 'moon' && <><path d="M20.5 15.4A8.5 8.5 0 0 1 8.6 3.5 8.5 8.5 0 1 0 20.5 15.4Z" fill="currentColor" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" /></>}
  {name === 'quote' && <><path d="M5 6.5h5v5H7.5c0 3 1 4.4 3.2 5.4M14 6.5h5v5h-2.5c0 3 1 4.4 3.2 5.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" /></>}
  {name === 'tag' && <path d="M4 5.2V11l8 8 7-7-8-8H5.2A1.2 1.2 0 0 0 4 5.2Zm3.2 2.3h.01" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />}
  {name === 'chevron' && <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" /></>}
  {name === 'article' && <><rect x="5" y="3.5" width="14" height="17" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M8 8h8M8 12h8M8 16h5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.5" /></>}
  {name === 'github' && <path fill="currentColor" d="M12 2.3a9.7 9.7 0 0 0-3.07 18.9c.49.09.67-.21.67-.47v-1.84c-2.72.59-3.3-1.15-3.3-1.15-.44-1.13-1.07-1.43-1.07-1.43-.88-.61.07-.6.07-.6.97.07 1.48 1 1.48 1 .86 1.47 2.27 1.05 2.83.8.09-.63.34-1.05.61-1.29-2.17-.25-4.45-1.08-4.45-4.81 0-1.06.38-1.93 1-2.61-.1-.25-.43-1.31.1-2.58 0 0 .82-.26 2.68 1a9.3 9.3 0 0 1 4.88 0c1.86-1.26 2.68-1 2.68-1 .53 1.27.2 2.33.1 2.58.62.68 1 1.55 1 2.61 0 3.74-2.28 4.56-4.46 4.8.35.3.65.87.65 1.75v2.77c0 .27.18.57.68.47A9.7 9.7 0 0 0 12 2.3Z" />}
  {name === 'link' && <><path d="m9.5 14.5-1.2 1.2a3.2 3.2 0 1 1-4.5-4.5l2.6-2.6a3.2 3.2 0 0 1 4.5 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" /><path d="m14.5 9.5 1.2-1.2a3.2 3.2 0 1 1 4.5 4.5l-2.6 2.6a3.2 3.2 0 0 1-4.5 0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" /><path d="m8.5 15.5 7-7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" /></>}
</svg>
