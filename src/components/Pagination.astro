---
import { archivePath, pagePath } from '../lib/routing'
import { messagesFor } from '../lib/i18n'
import { config } from '../lib/config'
interface Props { page: number; pageCount: number; kind?: 'home' | 'archive' }
const { page, pageCount, kind = 'home' } = Astro.props
const pathFor = (value: number) => kind === 'archive' ? archivePath(value) : pagePath(value)
const messages = messagesFor(config.site.language)
---
{pageCount > 1 && (
  <nav class="pagination" aria-label="Pagination">
    {page > 1 && <a class="page-navigator" href={pathFor(page - 1)} aria-label={messages.newer}>←</a>}
    <span class="pagination-pages">
      {Array.from({ length: pageCount }, (_, index) => index + 1).map((number) => (
        <a class:list={{ active: number === page }} href={pathFor(number)} aria-current={number === page ? 'page' : undefined}>{number}</a>
      ))}
    </span>
    {page < pageCount && <a class="page-navigator" href={pathFor(page + 1)} aria-label={messages.older}>→</a>}
  </nav>
)}
