---
import { categoryPath, pagePath } from '../lib/routing'
import { messagesFor, type AuroraLocale } from '../lib/i18n'
interface Category { name: string; count: number }
interface Props { categories: Category[]; active?: string; locale?: AuroraLocale }
const { categories, active = '', locale = 'en' } = Astro.props
const messages = messagesFor(locale)
---

<nav class="category-tabs" aria-label={messages.categories}>
  <a class:list={{ active: active === '' }} class="category-tab category-tab--all" href={pagePath(1, locale)}>{messages.all} <span>{categories.reduce((sum, item) => sum + item.count, 0)}</span></a>
  {categories.map((category) => (
    <a class:list={{ active: active === category.name }} class="category-tab" href={categoryPath(category.name, locale)}>
      {category.name} <span>{category.count}</span>
    </a>
  ))}
</nav>
