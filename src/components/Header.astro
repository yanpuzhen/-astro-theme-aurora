---
import { config } from '../lib/config'
import { sitePath } from '../lib/routing'
import ThemeIsland from '../islands/ThemeIsland.vue'
import MobileMenuIsland from '../islands/MobileMenuIsland.vue'
const currentPath = Astro.url.pathname
const menu = config.menu.map((item) => ({
  ...item,
  href: /^(?:[a-z][a-z\d+.-]*:|\/\/)/i.test(item.href) ? item.href : sitePath(item.href),
}))
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-logo" href={sitePath('/')} aria-label={config.site.title}>{config.site.title}</a>
    <nav aria-label="Primary navigation">
      {menu.map((item) => (
        <a class:list={{ active: currentPath === item.href }} href={item.href}>{item.label}</a>
      ))}
    </nav>
    <a class="header-search" href={sitePath('/search/')} aria-label="Search">⌕</a>
    <ThemeIsland client:load />
    <MobileMenuIsland client:load menu={menu} />
  </div>
</header>
