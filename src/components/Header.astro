---
import { config } from '../lib/config'
import { sitePath } from '../lib/routing'
import ThemeIsland from '../islands/ThemeIsland.vue'
import MobileMenuIsland from '../islands/MobileMenuIsland.vue'
import SearchIsland from '../islands/SearchIsland.vue'
import Icon from './Icon.astro'
const currentPath = Astro.url.pathname
const menu = config.menu.map((item) => ({
  ...item,
  href: /^(?:[a-z][a-z\d+.-]*:|\/\/)/i.test(item.href) ? item.href : sitePath(item.href),
}))
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-logo" href={sitePath('/')} aria-label={config.site.title}>
      <img src={sitePath('/favicon.svg')} alt="" />
      <span><strong>{config.site.author}</strong><small>AURORA 3.0</small></span>
    </a>
    <nav class="desktop-navigation" aria-label="Primary navigation">
      {menu.map((item) => (
        <a class:list={{ active: currentPath === item.href }} href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="header-controls">
      <SearchIsland client:load overlay base={import.meta.env.BASE_URL} searchHref={sitePath('/search/')} />
      <span class="header-control header-language" aria-label="Language"><Icon name="language" /><span>{config.site.language === 'zh-CN' ? '简体' : 'En'}</span></span>
      <ThemeIsland client:load />
    </div>
    <MobileMenuIsland client:load menu={menu} logo={sitePath('/favicon.svg')} />
  </div>
</header>
