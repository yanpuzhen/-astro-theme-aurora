---
import packageInfo from '../../package.json'
import { config } from '../lib/config'
import { localizedSitePath, publicAssetPath } from '../lib/routing'
import { demoFooter, demoProfile, isDemoBuild, runningDays } from '../lib/showcase'
import { messagesFor, type AuroraLocale } from '../lib/i18n'

interface Props { locale?: AuroraLocale }
const { locale = config.site.language } = Astro.props
const messages = messagesFor(locale)
const demo = isDemoBuild()
const profile = demo ? demoProfile[locale] : undefined
const startedDate = demo ? demoFooter.startedDate : config.site.startedDate
const days = runningDays(startedDate)
const pageViews = demo ? demoFooter.pageViews : config.statistics.pageViews
const uniqueVisitors = demo ? demoFooter.uniqueVisitors : config.statistics.uniqueVisitors
const currentYear = new Date().getFullYear()
const startYear = startedDate ? new Date(`${startedDate}T00:00:00Z`).getUTCFullYear() : currentYear
const avatar = profile?.avatar || config.site.avatar
---
<footer class="site-footer" id="footer">
  <div class="site-footer__rule" aria-hidden="true"></div>
  <div class="site-footer__inner">
    <div class="site-footer__copy">
      <p>Copyright © {startYear} - {currentYear} <strong>{demo ? profile?.name : config.site.author}</strong>. {messages.rightsReserved}</p>
      <p>{messages.poweredBy} <a href="https://astro.build/">Astro</a> &amp; {messages.themedBy} <a href={localizedSitePath('/', locale)}>Aurora v{packageInfo.version}</a>.</p>
      <p class="footer-attribution">{messages.originalVisualSystem} <a href="https://github.com/auroral-ui/hexo-theme-aurora">Auroral-UI</a> under the MIT License.</p>
      {config.beian.policeNumber && <p class="footer-beian">公安备案：<a href={config.beian.policeLink}>{config.beian.policeNumber}</a></p>}
      {config.beian.number && <p class="footer-beian">备案信息：<a href={config.beian.link}>{config.beian.number}</a></p>}
    </div>
    <div class="site-footer__middle">
      <div class="site-footer__links">
        <a href={localizedSitePath('/archives/', locale)}>{messages.archives}</a>
        <a href={localizedSitePath('/tags/', locale)}>{messages.tags}</a>
        <a href={localizedSitePath('/links/', locale)}>{messages.links}</a>
      </div>
      {(pageViews || uniqueVisitors || days !== undefined) && <dl class="footer-stats" aria-label={messages.siteRunningFor}>
        {pageViews && <div><dt><span aria-hidden="true">◉</span> {messages.pageViews}</dt><dd>{pageViews}</dd></div>}
        {uniqueVisitors && <div><dt><span aria-hidden="true">◈</span> {messages.uniqueVisitors}</dt><dd>{uniqueVisitors}</dd></div>}
        {days !== undefined && <div><dt><span aria-hidden="true">◷</span> {messages.siteRunningFor}</dt><dd>{days} {messages.day}</dd></div>}
      </dl>}
      {demo && <small class="footer-fixture-note">{messages.demoStats}</small>}
    </div>
    {avatar ? <img class="footer-avatar diamond-avatar" src={publicAssetPath(avatar)} alt={demo ? profile?.name : ''} loading="lazy" /> : <span class="footer-avatar footer-avatar--mark" aria-hidden="true">✦</span>}
  </div>
</footer>
