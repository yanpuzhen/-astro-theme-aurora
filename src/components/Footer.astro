---
import { config } from '../lib/config'
import { sitePath } from '../lib/routing'
---
<footer class="site-footer" id="footer">
  <div class="site-footer__rule" aria-hidden="true"></div>
  <div class="site-footer__inner">
    <div class="site-footer__copy">
      <p>Copyright © 2019 - {new Date().getFullYear()} <strong>{config.site.author}</strong>. All Rights Reserved.</p>
      <p>Powered by <a href="https://astro.build/">Astro</a> &amp; themed by <a href={sitePath('/')}>Aurora 3.0</a>.</p>
      <p class="footer-attribution">Original visual system by <a href="https://github.com/auroral-ui/hexo-theme-aurora">Auroral-UI</a> under the MIT License.</p>
    </div>
    <div class="site-footer__links">
      <a href={sitePath('/archives/')}>Archives</a>
      <a href={sitePath('/tags/')}>Tags</a>
      <a href={sitePath('/links/')}>Links</a>
    </div>
    <img class="footer-avatar diamond-avatar" src={sitePath('/favicon.svg')} alt="" />
  </div>
</footer>
