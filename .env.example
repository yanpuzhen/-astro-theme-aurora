# Public site URL and deployment prefix used by Astro's static build.
ASTRO_SITE=https://example.com
ASTRO_BASE=/

# Optional public build-time theme configuration.
PUBLIC_AURORA_LOCALE=en
PUBLIC_AURORA_DIA=false

# Set to none, gitalk, valine, twikoo, or waline.
PUBLIC_COMMENT_PROVIDER=none
PUBLIC_GITALK_ID_MODE=uid

# Public provider configuration. Leave blank until the provider is configured.
PUBLIC_GITALK_CLIENT_ID=
PUBLIC_GITALK_OWNER=
PUBLIC_GITALK_REPO=
PUBLIC_VALINE_APP_ID=
PUBLIC_VALINE_APP_KEY=
PUBLIC_TWIKOO_ENV_ID=
PUBLIC_WALINE_SERVER_URL=

# Browser-test-only overrides; not needed for the production build.
PLAYWRIGHT_ORIGIN=http://127.0.0.1:4321
PLAYWRIGHT_BASE_PATH=

# There is intentionally no PUBLIC_GITALK_CLIENT_SECRET. A static build must
# not serialize an OAuth client secret; use a trusted OAuth/proxy service.
