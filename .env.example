# Deployment overrides. These take precedence over the corresponding _config.yml values.
ASTRO_SITE=https://example.com
ASTRO_BASE=/
ASTRO_DEMO_BUILD=false

# Optional public build-time overrides. Leave blank to use _config.yml.
PUBLIC_AURORA_TITLE=
PUBLIC_AURORA_SUBTITLE=
PUBLIC_AURORA_AUTHOR=
PUBLIC_AURORA_DESCRIPTION=
PUBLIC_AURORA_LOCALE=
PUBLIC_AURORA_AVATAR=
PUBLIC_AURORA_LOGO=
PUBLIC_AURORA_STARTED_DATE=
PUBLIC_AURORA_DIA=
PUBLIC_AURORA_PAGE_VIEWS=
PUBLIC_AURORA_UNIQUE_VISITORS=
PUBLIC_AURORA_BEIAN_NUMBER=
PUBLIC_AURORA_BEIAN_LINK=
PUBLIC_AURORA_POLICE_BEIAN_NUMBER=
PUBLIC_AURORA_POLICE_BEIAN_LINK=

# Optional provider overrides. These values are public in a static site build.
PUBLIC_COMMENT_PROVIDER=
PUBLIC_VALINE_APP_ID=
PUBLIC_VALINE_APP_KEY=
PUBLIC_TWIKOO_ENV_ID=
PUBLIC_TWIKOO_REGION=
PUBLIC_WALINE_SERVER_URL=

# Browser-test-only variables.
PLAYWRIGHT_ORIGIN=http://127.0.0.1:4321
PLAYWRIGHT_BASE_PATH=

# Configure giscus in _config.yml. No OAuth client secret or GitHub token is needed.
